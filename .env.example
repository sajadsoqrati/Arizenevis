# Database (Docker Compose maps host 5433 -> container 5432)
DATABASE_URL=postgresql://lawuser:lawpass@localhost:5433/lawdb

# JWT secrets (change in production!)
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long!

# Server
PORT=4000
FRONTEND_URL=http://localhost:3000

# Admin seed user
ADMIN_NATIONAL_ID=0000000000
ADMIN_PASSWORD=Admin@123

# Zarinpal (sandbox)
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:4000/api/payments/verify

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
