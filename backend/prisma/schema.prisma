generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  COWORKER
  MARKETER
  ADMIN
}

enum HelpRequestStatus {
  PENDING_PRICE
  PRICED
  PAID
  ANSWERED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum BudgetRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  nationalId   String   @unique
  jobTitle     String
  role         Role
  passwordHash String
  phone        String
  city         String
  province     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  helpRequests    HelpRequest[]
  refreshTokens   RefreshToken[]
  marketerProfile MarketerProfile?
  coworkerLink    CoworkerLink?
  blogPosts       BlogPost[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model MarketerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralCode String   @unique
  createdAt    DateTime @default(now())

  coworkers      CoworkerLink[]
  budgetRequests BudgetRequest[]
  commissions    MarketerCommission[]
}

model CoworkerLink {
  id                String          @id @default(cuid())
  coworkerId        String          @unique
  coworker          User            @relation(fields: [coworkerId], references: [id], onDelete: Cascade)
  marketerProfileId String
  marketerProfile   MarketerProfile @relation(fields: [marketerProfileId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
}

model ServiceCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  createdAt DateTime @default(now())

  helpRequests HelpRequest[]
}

model HelpRequest {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId        String
  category          ServiceCategory   @relation(fields: [categoryId], references: [id])
  question          String
  price             Int?
  answerDeadline    DateTime?
  status            HelpRequestStatus @default(PENDING_PRICE)
  interactionNumber Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  payment Payment?
}

model Payment {
  id                String        @id @default(cuid())
  helpRequestId     String        @unique
  helpRequest       HelpRequest   @relation(fields: [helpRequestId], references: [id], onDelete: Cascade)
  originalPrice     Int
  discountAmount    Int           @default(0)
  finalAmount       Int
  status            PaymentStatus @default(PENDING)
  discountCodeId    String?
  discountCode      DiscountCode? @relation(fields: [discountCodeId], references: [id])
  zarinpalAuthority String?
  zarinpalRefId     String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  commission MarketerCommission?
}

model DiscountCode {
  id            String   @id @default(cuid())
  code          String   @unique
  percentOff    Int
  maxUses       Int?
  usedCount     Int      @default(0)
  isActive      Boolean  @default(true)
  firstTimeOnly Boolean  @default(false)
  createdAt     DateTime @default(now())

  payments Payment[]
}

model MarketerCommission {
  id                String          @id @default(cuid())
  paymentId         String          @unique
  payment           Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  marketerProfileId String
  marketerProfile   MarketerProfile @relation(fields: [marketerProfileId], references: [id])
  interactionNumber Int
  rate              Float
  amount            Int
  createdAt         DateTime        @default(now())
}

model BudgetRequest {
  id                String              @id @default(cuid())
  marketerProfileId String
  marketerProfile   MarketerProfile     @relation(fields: [marketerProfileId], references: [id], onDelete: Cascade)
  amount            Int
  description       String
  status            BudgetRequestStatus @default(PENDING)
  adminNote         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  published Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
